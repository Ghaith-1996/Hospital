# Copy this file to .env. The copied file is ignored and must remain local.
# Use fictional development-only values; never use hospital, employee, patient, or provider data.
POSTGRES_DB=critical_alerts_dev
POSTGRES_USER=critical_alerts_dev
POSTGRES_PASSWORD=<local-only-development-password>
POSTGRES_PORT=55432
# 32-byte local-only AES key as base64. Generate with:
# [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# Never use a hospital, employee, patient, or production key.
CRITICAL_ALERTS_DATA_PROTECTION_KEY=
# Phase 12 (optional, default Simulation): test-number-only Azure Communication Services SMS.
# Put real values only in ignored configuration or a secret store; never commit an access key or phone number.
# Communications__Sms__Provider=AzureCommunicationServices
# Communications__Sms__AzureCommunicationServices__Endpoint=https://<resource>.communication.azure.com
# Communications__Sms__AzureCommunicationServices__AccessKey=
# Communications__Sms__AzureCommunicationServices__FromNumber=
# Communications__Sms__AzureCommunicationServices__TestRecipients__SIM-SMS-0101=
# Communications__Webhooks__EventGrid__Enabled=false (when true also set TenantId, Audience, ExpectedTopic, SubscriptionName, SenderApplicationId)
# Local API used by the Next.js rewrite for development authentication.
CRITICAL_ALERTS_API_URL=http://127.0.0.1:5080
